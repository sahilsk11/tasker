{
  "name": "tasker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:lines": "node scripts/check-file-lines.mjs",
    "dev:api": "pnpm --filter @tasker/api dev",
    "dev:web": "pnpm --filter @tasker/web dev",
    "dev:worker": "pnpm --filter @tasker/worker dev",
    "install-daemon": "node scripts/install-daemon.mjs",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --max-warnings 0 && node scripts/check-file-lines.mjs",
    "smoke:migrations": "pnpm --filter @tasker/api smoke:migrations",
    "test": "pnpm --filter @tasker/core build && pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.3",
    "eslint": "^9.29.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.15.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
